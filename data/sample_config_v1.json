{
  "version": "v1",
  "module": "MVB",
  "parser_version": "1.0.0",
  "byte_order": "little",
  "parse_mode": "standard",
  "signal_map": {
    "speed": {"offset": 0, "length": 2, "scale": 0.1},
    "temp": {"offset": 2, "length": 2, "scale": 0.1}
  },
  "second_parse": {
    "plot_metrics": ["speed_avg", "temp_max"],
    "downsample": {"method": "mean", "step": 10}
  }
}